{
  "name": "ai-quota-monitor",
  "version": "0.1.0",
  "description": "Windows Electron 桌面监控：ChatGPT / Grok / Gemini 剩余额度",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
